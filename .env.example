PORT=5020
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5020
FRONTEND_BASE_URL=http://localhost:5020
UNIPILE_BASE_URL=https://your-dsn.unipile.com:port/api/v1
UNIPILE_API_KEY=your_access_token
UNIPILE_CALLBACK_SECRET=generate_a_long_random_secret
UNIPILE_WEBHOOK_SECRET=generate_a_different_long_random_secret
REQUEST_TIMEOUT=10000
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
FIREBASE_APP_ID=your_firebase_web_app_id
GOOGLE_APPLICATION_CREDENTIALS=C:\\absolute\\path\\to\\firebase-service-account.json

# cPanel autoforwarding mailboxes (optional; existing Unipile routes do not need these)
CPANEL_BASE_URL=https://your-cpanel-host:2083
CPANEL_USERNAME=your_cpanel_username
CPANEL_API_TOKEN=your_cpanel_api_token
CPANEL_EMAIL_DOMAIN=example.com
CPANEL_REQUEST_TIMEOUT=15000
CPANEL_MAILBOX_QUOTA_MB=100
CPANEL_MAILBOX_PREFIX=fwd
CPANEL_IMAP_HOST=mail.example.com
CPANEL_IMAP_PORT=993
CPANEL_IMAP_SECURE=true
CPANEL_IMAP_SYNC_LIMIT=250
CPANEL_SMTP_HOST=mail.example.com
CPANEL_SMTP_PORT=465
CPANEL_SMTP_SECURE=true
# Generate 32 random bytes and store them as base64 or 64 hexadecimal characters.
FORWARDING_CREDENTIALS_KEY=your_32_byte_encryption_key
